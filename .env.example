# Copy to .env and change before any real deployment
POSTGRES_PASSWORD=change-me-db
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
AI_API_KEY=change-me-shared-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
SEED_DEMO=true
# Set to true to bake sentence-transformers/TrOCR into the AI image (adds ~2GB)
INSTALL_ML=false
EMBEDDING_BACKEND=auto
OCR_ENGINE=tesseract
